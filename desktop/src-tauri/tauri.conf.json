{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kivora",
  "version": "0.1.0",
  "identifier": "org.kivora.messenger",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kivora",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Self-hosted end-to-end encrypted messenger",
    "longDescription": "Kivora is a self-hosted messenger with pluggable end-to-end encryption. The desktop app keeps its key material outside the web layer, in the operating system's credential store.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
